{
  "manifest_version": 3,
  "name": "Showdown Battle Assistant",
  "version": "1.0.0",
  "description": "Tracks your Pokémon Showdown battle and recommends moves. Built for practice and friend battles — using it on the ladder is cheating.",
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "downloads"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Showdown Battle Assistant"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
